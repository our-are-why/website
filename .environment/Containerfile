FROM image_develop-base

# static-web-server is a single static binary; copy it straight out of its
# official multi-arch image: https://static-web-server.net
COPY --from=joseluisq/static-web-server:2.44.1@sha256:94618e3d17802265a21926217e6f9e7832b311b6fbf5933684001739fafed06a \
    /static-web-server /usr/local/bin/static-web-server

# ffmpeg, for scripts/encodeVideo.sh and scripts/makeImages.sh; Debian's build
# includes the SVT-AV1 and x264 encoders they use. The base image runs as
# coder, and apt needs root.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
USER coder

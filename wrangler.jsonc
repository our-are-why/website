// Tells Cloudflare Pages what to publish: the files in public/, exactly as
// they are, with no build step. Pages deploys on every push to the
// production branch, and serves public/404.html for addresses that don't
// exist. The name has to match the project's name in the Cloudflare
// dashboard.
{
  "name": "website",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-01"
}
